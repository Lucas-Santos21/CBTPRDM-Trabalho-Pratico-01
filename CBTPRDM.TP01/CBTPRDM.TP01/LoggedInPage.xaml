<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CBTPRDM.TP01.LoggedInPage"
             Title="Área Restrita">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
        <Label Text="Logado com Sucesso!" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Bem-vindo ao sistema." FontSize="18" HorizontalOptions="Center" />

        <Button Text="Sair (Logout)" Clicked="OnSairClicked" WidthRequest="200" Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>
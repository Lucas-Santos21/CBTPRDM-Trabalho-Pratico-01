<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CBTPRDM.TP01.MainPage"
             BackgroundColor="Black">

    <VerticalStackLayout Padding="40" Spacing="15" VerticalOptions="Center">

        <Label Text="Trabalho Prático 01" 
               FontSize="32" 
               FontAttributes="Bold" 
               TextColor="White" 
               HorizontalOptions="Center" 
               Margin="0,0,0,30" />

        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="15" ColumnSpacing="10">

            <Label Grid.Row="0" Grid.Column="0" Text="ID:" FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
            <Entry Grid.Row="0" Grid.Column="1" x:Name="IdEntry" BackgroundColor="White" TextColor="Black"/>

            <Label Grid.Row="1" Grid.Column="0" Text="Pass" FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="1" x:Name="PassEntry" IsPassword="True" BackgroundColor="White" TextColor="Black"/>

        </Grid>

        <Button Text="OK" FontAttributes="Bold" BackgroundColor="LightGray" TextColor="DarkRed" Clicked="OnOkClicked" Margin="0,30,0,0" />
        <Button Text="Limpar" FontAttributes="Bold" BackgroundColor="LightGray" TextColor="DarkRed" Clicked="OnLimparClicked" />
        <Button Text="Créditos" FontAttributes="Bold" BackgroundColor="LightGray" TextColor="DarkRed" Clicked="OnCreditosClicked" />

    </VerticalStackLayout>
</ContentPage>